  "main_section_html": "\n\n<div class=\"portal-header mb-5\">\n    <h2 class=\"font-weight-bold\">Student Activity Portal</h2>\n    <p class=\"text-muted\">Manage and track your college achievements in one place.</p>\n</div>\n\n<div class=\"row mb-4\">\n    <div class=\"col-md-4\">\n        <div class=\"card border-0 shadow-sm bg-success text-white\">\n            <div class=\"card-body\">\n                <h6>Verified Activities</h6>\n                <h3>{{ frappe.db.count(\"Activity Management\", {\"owner\": frappe.session.user, \"workflow_state\": \"Approved\"}) }}</h3>\n            </div>\n        </div>\n    </div>\n    <div class=\"col-md-4\">\n        <div class=\"card border-0 shadow-sm bg-warning text-dark\">\n            <div class=\"card-body\">\n                <h6>Awaiting Verification</h6>\n                <h3>{{ frappe.db.count(\"Activity Management\", {\"owner\": frappe.session.user, \"workflow_state\": \"Pending Approval\"}) }}</h3>\n            </div>\n        </div>\n    </div>\n    <div class=\"col-md-4\">\n        <div class=\"card border-0 shadow-sm h-100 d-flex align-items-center justify-content-center\" style=\"border: 2px dashed #dee2e6 !important;\">\n            <a href=\"activities/new\" class=\"text-primary font-weight-bold\">+ Add New Achievement</a>\n        </div>\n    </div>\n</div>\n<div class=\"card border-0 shadow-sm\">\n    <div class=\"card-body p-0\">\n        <table class=\"table table-hover mb-0\">\n            <thead class=\"bg-light text-uppercase small font-weight-bold\">\n                <tr>\n                    <th class=\"border-0 px-4\">Activity</th>\n                    <th class=\"border-0\">Category</th>\n                    <th class=\"border-0\">Status</th>\n                    <th class=\"border-0 text-right px-4\">Actions</th>\n                </tr>\n            </thead>\n            <tbody>\n                {% set activities = frappe.get_all(\"Activity Management\", \n                    filters={\"owner\": frappe.session.user}, \n                    fields=[\"name\", \"event_name\", \"category\", \"workflow_state\"]) %}\n                {% for row in activities %}\n                <tr>\n                    <td class=\"px-4 align-middle\">\n                        <div class=\"font-weight-bold\">{{ row.event_name }}</div>\n                        <div class=\"text-muted small\">ID: {{ row.name }}</div>\n                    </td>\n                    <td class=\"align-middle text-muted\">{{ row.category }}</td>\n                    <td class=\"align-middle\">\n                        {% if row.workflow_state == 'Approved' %}\n                            <span class=\"text-success\">● <span class=\"text-dark\">Verified</span></span>\n                        {% elif row.workflow_state == 'Rejected' %}\n                            <span class=\"text-danger\">● <span class=\"text-dark\">Rejected</span></span>\n                        {% else %}\n                            <span class=\"text-warning\">● <span class=\"text-dark\">In Review</span></span>\n                        {% endif %}\n                    </td>\n                    <td class=\"text-right px-4 align-middle\">\n                        <div class=\"dropdown\">\n                            <button class=\"btn btn-light btn-sm dropdown-toggle\" data-toggle=\"dropdown\">Manage</button>\n                            <div class=\"dropdown-menu dropdown-menu-right\">\n                                <a class=\"dropdown-item\" href=\"/edit-activity?name={{ row.name }}\">View Details</a>\n                                {% if row.workflow_state == 'Approved' %}\n                                <a class=\"dropdown-item text-primary\" href=\"/api/method/frappe.utils.print_format.download_pdf?doctype=Activity%20Management&name={{ row.name }}\">Download PDF</a>\n                                {% endif %}\n                            </div>\n                        </div>\n                    </td>\n                </tr>\n                {% endfor %}\n            </tbody>\n        </table>\n    </div>\n</div>",
