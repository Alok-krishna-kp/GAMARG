  "css": "body { background-color: #f8f9fa; }\n.card { border-radius: 12px; }\n.table thead th { color: #6c757d; letter-spacing: 0.05em; }\n.btn-primary { border-radius: 8px; padding: 8px 20px; box-shadow: 0 4px 6px rgba(58, 87, 232, 0.3); }\n.dropdown-menu { border: none; shadow: 0 10px 15px -3px rgba(0,0,0,0.1); border-radius: 10px; }",
